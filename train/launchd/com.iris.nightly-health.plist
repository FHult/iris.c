<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly GPU-free health run (pytest + C build + C unit tests).
     Install:  cp train/launchd/com.iris.nightly-health.plist ~/Library/LaunchAgents/
               launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.iris.nightly-health.plist
     Remove:   launchctl bootout gui/$(id -u)/com.iris.nightly-health
     Result consumed by pipeline_doctor (_check_nightly_health). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iris.nightly-health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fredrikhult/src/iris.c/train/scripts/nightly_health.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/fredrikhult/src/iris.c</string>
    <!-- stdio on the boot volume: launchd fails EX_CONFIG(78) opening these on an
         external /Volumes mount at load. The script logs to /Volumes itself. -->
    <key>StandardOutPath</key>
    <string>/Users/fredrikhult/Library/Logs/iris-nightly-health.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fredrikhult/Library/Logs/iris-nightly-health.log</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
